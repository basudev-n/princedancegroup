# Copy to .env.local and fill in real values — never commit .env.local.
# See ARCHITECTURE.md §8/§9 and TODO.md Phase 0.

# Production domain (Netlify Site configuration → Environment variables).
# Required before deploying — without it, sitemap.xml/robots.txt/OG tags
# ship with localhost URLs baked in. See src/lib/siteUrl.ts.
NEXT_PUBLIC_SITE_URL=

# Formspree form ID (https://formspree.io/f/<id> — create a form, then
# paste just the <id> here, not the full URL). Every enquiry form on the
# site (src/lib/submitEnquiry.ts) posts directly to Formspree once this is
# set. Public by design — Formspree endpoints are meant to be called from
# the browser, so this is NOT a secret. Until it's set, forms fall back to
# the honest "not connected yet" /api/contact stub below.
NEXT_PUBLIC_FORMSPREE_ID=

# Legacy fallback path (src/app/api/contact/route.ts) — only used if
# NEXT_PUBLIC_FORMSPREE_ID above is unset. Not currently wired to a real
# provider; see the TODO(integration) note in that file.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
